# ═══════════════════════════════════════════════════════
# 🍀 Shamrock Node-RED — Environment Variables
# ═══════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git!
# ═══════════════════════════════════════════════════════

# ── Node-RED Core ──
NR_CREDENTIAL_SECRET=shamrock-bail-2026
# Generate: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
NR_ADMIN_USER=admin
NR_ADMIN_HASH=
NR_VIEWER_USER=viewer
NR_VIEWER_HASH=

# ── Google Apps Script ──
# Keep this URL STABLE. Re-deploy existing GAS deployment; do not mint a new /exec path.
# If the URL must change: notify human → update Wix Secrets Manager + this env.
# Policy: shamrock-leads/docs/policies/gas-url-policy.md
GAS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GAS_API_KEY=

# ── Leads Super CRM (lifecycle automation sweeps) ──
# Same GAS_API_KEY authenticates POST /api/automation/*
LEADS_PUBLIC_URL=https://leads.shamrockbailbonds.biz
DASHBOARD_PUBLIC_URL=https://leads.shamrockbailbonds.biz

# ── Super admin (documentation / ops identity) ──
# Full admin across portal, school, leads when logged in as:
# admin@shamrockbailbonds.biz
ADMIN_EMAILS=admin@shamrockbailbonds.biz

# ── Slack ──
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WEBHOOK_OPS=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_ALERTS=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_LEADS=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Twilio ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+17272952245

# ── ElevenLabs ──
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=agent_2001kjth4na5ftqvdf1pp3gfb1cb

# ── DocuSeal (sole active e-sign — https://sign.shamrockbailbonds.biz) ──
# Staff packets are issued in Super CRM (shamrock-leads), not from Node-RED.
DOCUSEAL_API_URL=https://sign.shamrockbailbonds.biz
# SIGNNOW_* is permanently retired — do not configure for new work.
# SIGNNOW_API_KEY=retired

# ── Webhook Security ──
# Used for HMAC signature verification on inbound webhooks
WEBHOOK_HMAC_SECRET=generate-a-random-32-char-string

# ── GitHub ──
# For triggering scraper workflows via GitHub Actions API
GITHUB_PAT=github_pat_your_token_here

# ── MongoDB Atlas ──
# Use standard (non-SRV) connection string for Docker compatibility
# Get from: Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://admin:YOUR_PASSWORD@shamrock.1ngkm.mongodb.net/?retryWrites=true&w=majority

# ── Super CRM / Auto-CRM dashboard relays (canonical staff URL above) ──
# Prefer LEADS_PUBLIC_URL / DASHBOARD_PUBLIC_URL. Do NOT prefer raw Hetzner :8088 for staff.
SHAMROCK_DASHBOARD_URL=https://leads.shamrockbailbonds.biz
SHAMROCK_DASHBOARD_API_KEY=your-dashboard-api-key
# ElevenLabs phone number ID for outbound voice calls (Paperwork Chase escalation)
ELEVENLABS_PHONE_ID=your-elevenlabs-phone-number-id

# ── Logging ──
LOG_LEVEL=info
NODE_ENV=production

# ── Timezone ──
TZ=America/New_York
